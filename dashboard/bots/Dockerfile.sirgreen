FROM python:3.11-slim

RUN useradd -m -u 197609 botuser
WORKDIR /app

COPY requirements_sirgreen.txt .
RUN pip install --no-cache-dir -r requirements_sirgreen.txt

COPY sir_green_discord_bot.py .

ENV STATE_PATH=/state/sir_green_bot_state.json
VOLUME /state

USER botuser
CMD ["python", "sir_green_discord_bot.py"]
