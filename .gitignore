# VOID Pirate — Captain's Dashboard
# OPSEC-first: no secrets, no binaries, no temp artifacts.

# --- Secrets & local env ---
.env
.env.*
!.env.test
*.local
secrets/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.venv
venv/

# --- Node / Next.js ---
node_modules/
.next/
out/
.next/

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.bak

# --- OS ---
.DS_Store
Thumbs.ini
Desktop.ini

# --- DB & large binaries ---
*.db
*.sqlite
*.sqlite3
*.7z
*.zip
*.tar.gz

