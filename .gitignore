# VOID Pirate — Captain's Dashboard
# Gitignore for all machines

# --- Secrets ---
.env
.env.*
!.env.example
*.local
secrets/
configs/reports/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.venv
venv/
.venv/

# --- Node / Next.js ---
node_modules/
.next/
out/
.next/
*.tsbuildinfo

# --- Runtime databases ---
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# --- Logs ---
*.log
logs/

# --- Temp / scratch ---
tmp/
temp/
*.tmp
*.swp
*.bak
_SCRATCH/
_archive/
_tmp_*
_scan_*
_ollama/

# --- OS ---
.DS_Store
Thumbs.ini
Desktop.ini

# --- Large binaries ---
*.7z
*.zip
*.tar.gz
*.rar

# --- IDE ---
.vscode/
.idea/
